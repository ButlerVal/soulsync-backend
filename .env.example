# --- Application Settings ---
APP_NAME=SoulSync
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# --- Database (PostgreSQL 13) ---
# Use 'postgresql+asyncpg://' for async connection
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/soulsync_db

# --- Security & JWT ---
# Generate a strong key, e.g., using: openssl rand -hex 32
SECRET_KEY=PLEASE_REPLACE_ME_WITH_A_REAL_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Caching (Redis) ---
REDIS_HOST=localhost
REDIS_PORT=6379